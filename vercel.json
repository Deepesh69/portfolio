{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/admin/(.*)", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/login/", "destination": "/login.html" },
    { "source": "/login/(.*)", "destination": "/login.html" },
    { "source": "/uploads/(.*)", "destination": "/uploads/$1" },
    { "source": "/data/(.*)", "destination": "/data/$1" },
    { "source": "/css/(.*)", "destination": "/css/$1" },
    { "source": "/js/(.*)", "destination": "/js/$1" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/((?!api|uploads|data|css|js).*)", "destination": "/index.html" }
  ]
}
